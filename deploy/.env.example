# ---- required ----------------------------------------------------------------
# DNS A record of this name -> the server's IP (Caddy gets the TLS certificate itself)
DOMAIN=tx.example.ir
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# ---- optional ----------------------------------------------------------------
SITE_NAME=دخل و خرج
LOG_LEVEL=INFO
# iCloud link of a ready-made shortcut with import questions (shown on the setup page)
SHORTCUT_URL=
# enables /metrics for scraping with "Authorization: Bearer <token>" (empty = disabled)
METRICS_TOKEN=
INVITE_DAYS=7
# warn a user when their iPhone has sent nothing for this many days
SILENT_DAYS=3
WEB_CONCURRENCY=3

# ---- backups -------------------------------------------------------------------
# set to "backup" after filling in backup.env (see README "Backups")
COMPOSE_PROFILES=

# ---- Iran servers: Docker Hub / PyPI may be blocked -----------------------------
# Either configure a registry mirror in /etc/docker/daemon.json (recommended), or
# prefix the images with a mirror, e.g.:
# PYTHON_IMAGE=docker.arvancloud.ir/python:3.13-slim
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:17-alpine
# CADDY_IMAGE=docker.arvancloud.ir/caddy:2.10-alpine
# RESTIC_IMAGE=docker.arvancloud.ir/restic/restic:0.18.1
# PIP_INDEX_URL=https://<your-pypi-mirror>/simple
