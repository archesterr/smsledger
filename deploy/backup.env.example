# restic repository somewhere OTHER than this server (another provider / region).
# S3-compatible object storage, e.g. ArvanCloud, MinIO, AWS:
RESTIC_REPOSITORY=s3:https://s3.example.com/my-bucket/smsledger
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Encrypts the backups. Store a copy outside this server: without it the backups are unreadable.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RESTIC_PASSWORD=
# local hour (Asia/Tehran) of the daily backup
BACKUP_HOUR=3
